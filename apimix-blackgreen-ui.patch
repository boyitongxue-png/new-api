diff --git a/web/src/styles/apimix.css b/web/src/styles/apimix.css
index 23b1c74..6123b2c 100644
--- a/web/src/styles/apimix.css
+++ b/web/src/styles/apimix.css
@@ -64,3 +64,1026 @@ For commercial licensing, please contact support@quantumnous.com
     font-family: var(--font-apimix-mono);
   }
 }
+
+/* ═════════════════════════════════════════════════════════════════════════
+ * Built-in landing page (features/home/components/landing).
+ * Scoped to `.amx-home`. Surfaces/ink follow the active theme tokens so the
+ * page also reads in light mode; lime fills are fixed brand color with black
+ * text, lime-as-text switches to `--brand-text` (olive in light mode).
+ * ═════════════════════════════════════════════════════════════════════════ */
+.amx-home {
+  --amx-bg: var(--background);
+  --amx-ink: var(--foreground);
+  --amx-muted: var(--muted-foreground);
+  --amx-line: var(--border);
+  --amx-line-2: color-mix(in oklch, var(--foreground) 16%, transparent);
+  --amx-lime: #c8ff2e;
+  --amx-lime-hi: #d4ff55;
+  --amx-on-lime: #0b0b0a;
+  --amx-on-lime-soft: rgba(11, 11, 10, 0.74);
+  --amx-lime-line: rgba(11, 11, 10, 0.9);
+  --amx-accent-text: var(--brand-text, var(--primary));
+  --amx-mix-stroke: color-mix(in oklch, var(--foreground) 11%, transparent);
+  --amx-wordmark: var(--brand-text, var(--primary));
+  --amx-gutter: clamp(16px, 4.45vw, 64px);
+  --amx-section: clamp(64px, 7vw, 100px);
+  --amx-e-out: var(--ease-apimix-out);
+  --amx-e-inout: var(--ease-apimix-inout);
+  --amx-e-spring: var(--ease-apimix-spring);
+
+  position: relative;
+  background: var(--amx-bg);
+  color: var(--amx-ink);
+  font-family: var(--font-apimix);
+  font-size: 16px;
+  line-height: 1.6;
+  -webkit-font-smoothing: antialiased;
+  -moz-osx-font-smoothing: grayscale;
+  overflow-x: clip;
+}
+.dark .amx-home {
+  --amx-wordmark: var(--amx-lime);
+}
+.amx-home.is-holding *,
+.amx-home.is-holding *::before,
+.amx-home.is-holding *::after {
+  animation-play-state: paused !important;
+}
+.amx-home ::selection {
+  background: var(--amx-lime);
+  color: var(--amx-on-lime);
+}
+.amx-home :focus-visible {
+  outline: 2px solid var(--ring);
+  outline-offset: 3px;
+  border-radius: 4px;
+}
+/* film grain */
+.amx-home::after {
+  content: '';
+  position: fixed;
+  inset: 0;
+  z-index: 90;
+  pointer-events: none;
+  opacity: 0.03;
+  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
+  background-size: 220px 220px;
+}
+.dark .amx-home::after {
+  opacity: 0.045;
+}
+
+.amx-wrap {
+  width: 100%;
+  max-width: 1440px;
+  margin: 0 auto;
+  padding-inline: var(--amx-gutter);
+}
+.amx-mono {
+  font-family: var(--font-apimix-mono);
+  font-size: 12px;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--amx-muted);
+}
+
+/* buttons */
+.amx-btn {
+  --h: 54px;
+  position: relative;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 12px;
+  height: var(--h);
+  padding: 0 28px;
+  border-radius: 999px;
+  border: 1px solid transparent;
+  font-family: var(--font-apimix-cn);
+  font-size: 15px;
+  font-weight: 700;
+  letter-spacing: 0.02em;
+  white-space: nowrap;
+  cursor: pointer;
+  transition:
+    transform 0.6s var(--amx-e-out),
+    background-color 0.3s ease,
+    border-color 0.3s ease,
+    color 0.3s ease;
+  will-change: transform;
+}
+.amx-btn-label {
+  display: inline-flex;
+  align-items: center;
+  gap: 12px;
+  transition: transform 0.6s var(--amx-e-out);
+}
+.amx-btn-primary {
+  background: var(--amx-lime);
+  color: var(--amx-on-lime);
+}
+.amx-btn-primary:hover {
+  background: var(--amx-lime-hi);
+}
+.amx-btn-ghost {
+  border-color: var(--amx-line-2);
+  color: var(--amx-ink);
+  font-weight: 500;
+  background: color-mix(in oklch, var(--foreground) 1%, transparent);
+}
+.amx-btn-ghost:hover {
+  border-color: color-mix(in oklch, var(--foreground) 42%, transparent);
+  background: color-mix(in oklch, var(--foreground) 4%, transparent);
+}
+.amx-arr {
+  position: relative;
+  display: inline-block;
+  width: 16px;
+  height: 16px;
+  overflow: hidden;
+}
+.amx-arr svg {
+  position: absolute;
+  inset: 0;
+  width: 16px;
+  height: 16px;
+  transition: transform 0.5s var(--amx-e-out);
+}
+.amx-arr svg + svg {
+  transform: translateX(-130%);
+}
+.amx-btn:hover .amx-arr svg:first-child,
+.amx-btn:focus-visible .amx-arr svg:first-child {
+  transform: translateX(130%);
+}
+.amx-btn:hover .amx-arr svg + svg,
+.amx-btn:focus-visible .amx-arr svg + svg {
+  transform: translateX(0);
+}
+.amx-cta-group {
+  display: flex;
+  gap: 12px;
+  flex-wrap: wrap;
+}
+
+/* hero */
+.amx-hero {
+  position: relative;
+  min-height: clamp(660px, 100svh, 1000px);
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  isolation: isolate;
+}
+.amx-hero-mix {
+  position: absolute;
+  z-index: -1;
+  top: 96px;
+  right: -3.2vw;
+  width: min(64vw, 960px);
+  pointer-events: none;
+  will-change: transform;
+}
+.amx-hero-mix svg {
+  display: block;
+  width: 100%;
+  height: auto;
+  overflow: visible;
+}
+.amx-mix-text {
+  font-family: 'Space Grotesk', 'Noto Sans CJK SC', system-ui, sans-serif;
+  font-weight: 700;
+  font-size: 560px;
+  letter-spacing: -22px;
+  fill: none;
+  stroke-width: 1.4;
+  stroke-linejoin: round;
+}
+.amx-mix-base {
+  stroke: var(--amx-mix-stroke);
+  stroke-dasharray: 3400;
+  animation: amx-draw 1.55s cubic-bezier(0.65, 0, 0.35, 1) both;
+}
+.amx-mix-sheen {
+  stroke: var(--amx-accent-text);
