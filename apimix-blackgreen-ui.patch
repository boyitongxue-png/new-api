+/* ── API MIX ──────────────────────────────────────────────────────────── */
+/*
+ * The API MIX brand: a deep warm-black canvas, off-white ink, hairline
+ * borders and ONE acid-lime accent (#C8FF2E) that always carries black text.
+ * Inner pages are tools — lime is reserved for primary actions, the current /
+ * selected state and balance / top-up affordances.
+ *
+ * Light mode keeps the identity on a warm off-white canvas. Lime cannot be
+ * used as text on white (contrast ≈ 1.2:1), so `--primary` becomes an olive
+ * (#5B7A00, 4.9:1 with white text, ≈4.6:1 as text on the canvas) while brand
+ * call-to-action fills keep lime + black via the `--brand-*` tokens below
+ * (consumed by `.brand-fill` / `.text-brand` in apimix.css).
+ *
+ * Opted out of the semantic surface bridge above so surfaces stay neutral.
+ */
+[data-theme-preset='apimix'] {
+  --background: #f6f6f1;
+  --foreground: #121210;
+  --card: #ffffff;
+  --card-foreground: #121210;
+  --popover: #ffffff;
+  --popover-foreground: #121210;
+
+  --primary: #5b7a00;
+  --primary-foreground: #ffffff;
+  --secondary: #ecece5;
+  --secondary-foreground: #121210;
+  --muted: #efefe9;
+  --muted-foreground: #5e5e57;
+  --accent: #e9e9e1;
+  --accent-foreground: #121210;
+
+  --destructive: oklch(0.55 0.2 27);
+  --destructive-foreground: #ffffff;
+  --success: #2e8a57;
+  --success-foreground: #ffffff;
+  --warning: #d98e04;
+  --warning-foreground: #121210;
+  --info: #2f73b8;
+  --info-foreground: #ffffff;
+  --neutral: #5e5e57;
+  --neutral-foreground: #ffffff;
+
+  --border: #e2e2da;
+  --input: #d4d4cb;
+  --ring: #5b7a00;
+
+  --chart-1: #6f9400;
+  --chart-2: #2e8a57;
+  --chart-3: #2f73b8;
+  --chart-4: #d98e04;
+  --chart-5: #7b61d9;
+
+  --sidebar: #efefe8;
+  --sidebar-foreground: #121210;
+  --sidebar-primary: #5b7a00;
+  --sidebar-primary-foreground: #ffffff;
+  --sidebar-accent: #e4e4db;
+  --sidebar-accent-foreground: #121210;
+  --sidebar-border: #e2e2da;
+  --sidebar-ring: #5b7a00;
+
+  --skeleton-base: #e9e9e2;
+  --skeleton-highlight: #f3f3ee;
+
+  /* Brand tokens (no equivalent in other presets — consumers fall back to
+   * --primary / --primary-foreground when these are undefined). */
+  --brand-lime: #c8ff2e;
+  --brand-lime-hover: #d4ff55;
+  --brand-on-lime: #0b0b0a;
+  --brand-text: #5b7a00;
+  --brand-warn: #9a5b00;
+  --brand-warn-bg: rgba(217, 142, 4, 0.1);
+  --brand-warn-line: rgba(217, 142, 4, 0.45);
+
+  --radius: 0.75rem;
+}
