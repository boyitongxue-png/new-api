+/*
+ * API MIX brand layer.
+ *
+ * - Font stacks used by the `apimix` theme preset (see theme-presets.css) and
+ *   by the branded public surfaces (home, public header, auth split layout).
+ *   Space Grotesk / Noto Sans SC / JetBrains Mono are requested non-blocking
+ *   from index.html; every stack degrades to local CJK + system fonts.
+ * - `.brand-fill` / `.text-brand`: lime call-to-action fill and brand text.
+ *   They read the `--brand-*` tokens that only the `apimix` preset defines and
+ *   fall back to `--primary` so every other preset keeps working.
+ */
+:root {
+  --font-apimix:
+    'Space Grotesk', 'Noto Sans SC', 'Noto Sans CJK SC', 'PingFang SC',
+    'Hiragino Sans GB', 'Microsoft YaHei', 'Public Sans', system-ui, sans-serif;
+  --font-apimix-cn:
+    'Noto Sans SC', 'Noto Sans CJK SC', 'PingFang SC', 'Hiragino Sans GB',
+    'Microsoft YaHei', system-ui, sans-serif;
+  --font-apimix-mono:
+    'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas,
+    'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', monospace;
+  --ease-apimix-out: cubic-bezier(0.16, 1, 0.3, 1);
+  --ease-apimix-inout: cubic-bezier(0.77, 0, 0.18, 1);
+  --ease-apimix-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
+}
+
+@layer components {
+  .brand-fill {
+    background-color: var(--brand-lime, var(--primary));
+    color: var(--brand-on-lime, var(--primary-foreground));
+  }
+  .brand-fill:hover {
+    background-color: var(
+      --brand-lime-hover,
+      color-mix(in oklch, var(--primary) 88%, var(--background))
+    );
+  }
+  .text-brand {
+    color: var(--brand-text, var(--primary));
+  }
+  .font-apimix-cn {
+    font-family: var(--font-apimix-cn);
+    font-feature-settings: 'palt';
+  }
+  .font-apimix-mono {
+    font-family: var(--font-apimix-mono);
+  }
+}
