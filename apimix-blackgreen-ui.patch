+    <svg
+      viewBox='0 0 12 12'
+      fill='none'
+      stroke='currentColor'
+      strokeWidth='1.6'
+      strokeLinecap='round'
+      strokeLinejoin='round'
+      aria-hidden='true'
+    >
+      <path d='M2 6.3 4.7 9 10 3' />
