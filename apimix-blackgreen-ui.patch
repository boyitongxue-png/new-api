From 58b84bca70329e139177f751e1ecece55fcfea16 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 30 Sep 2026 17:35:24 -0800
Subject: [PATCH 7/8] feat(pricing): restrained billing pills and lime card
 hover edge

Render billing-mode tags as quiet outlined (token-based), dashed (per
request / per second) or filled (dynamic / resolution pricing) pills
instead of colored status badges, and sweep a lime top edge across model
cards on hover or keyboard focus. Presentation only; no data or pricing
logic changes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CNAh8zszdLbYYKhN2bHXj3
---
 .../components/model-billing-mode-badge.tsx   | 44 +++++++++++++------
 .../pricing/components/model-card.tsx         |  6 ++-
 2 files changed, 34 insertions(+), 16 deletions(-)

diff --git a/web/src/features/pricing/components/model-billing-mode-badge.tsx b/web/src/features/pricing/components/model-billing-mode-badge.tsx
index e95a1ac..acef3b7 100644
--- a/web/src/features/pricing/components/model-billing-mode-badge.tsx
+++ b/web/src/features/pricing/components/model-billing-mode-badge.tsx
@@ -18,7 +18,7 @@ For commercial licensing, please contact support@quantumnous.com
 */
 import { useTranslation } from 'react-i18next'
 
-import { StatusBadge, type StatusVariant } from '@/components/status-badge'
+import { cn } from '@/lib/utils'
 
 import { isDynamicPricingModel } from '../lib/dynamic-price'
 import { isTokenBasedModel } from '../lib/model-helpers'
@@ -33,35 +33,51 @@ interface ModelBillingModeBadgeProps {
   className?: string
 }
 
+/**
+ * Restrained pill treatments, one per billing family:
+ * - `outline`: metered by tokens (the common case)
+ * - `dashed`: flat per request / per second
+ * - `filled`: pricing that varies with the request (dynamic, resolution)
+ */
+type BillingTagStyle = 'outline' | 'dashed' | 'filled'
+
+const BILLING_TAG_STYLE_CLASSES: Record<BillingTagStyle, string> = {
+  outline: 'border-border text-foreground/85',
+  dashed: 'border-dashed border-foreground/30 text-muted-foreground',
+  filled: 'border-transparent bg-primary/15 text-foreground',
+}
+
 export function ModelBillingModeBadge(props: ModelBillingModeBadgeProps) {
   const { t } = useTranslation()
   let label = t('Per Request')
-  let variant: StatusVariant = 'purple'
+  let tagStyle: BillingTagStyle = 'dashed'
 
   if (hasTaskResolutionPricing(props.model)) {
     label = t('Video resolution pricing')
-    variant = 'cyan'
+    tagStyle = 'filled'
   } else if (hasImageResolutionPricing(props.model)) {
     label = t('Image resolution pricing')
-    variant = 'cyan'
+    tagStyle = 'filled'
   } else if (props.model.billing_mode === 'per-second') {
     label = t('Per second')
-    variant = 'info'
+    tagStyle = 'dashed'
   } else if (isDynamicPricingModel(props.model)) {
     label = t('Dynamic Pricing')
-    variant = 'warning'
+    tagStyle = 'filled'
   } else if (isTokenBasedModel(props.model)) {
     label = t('Token-based')
-    variant = 'info'
+    tagStyle = 'outline'
   }
 
   return (
-    <StatusBadge
-      label={label}
-      variant={variant}
-      copyable={false}
-      size='sm'
-      className={props.className}
-    />
+    <span
+      className={cn(
+        'inline-flex h-5 items-center rounded-full border px-2 text-[11px] leading-none font-medium whitespace-nowrap',
+        BILLING_TAG_STYLE_CLASSES[tagStyle],
+        props.className
+      )}
+    >
+      {label}
+    </span>
   )
 }
diff --git a/web/src/features/pricing/components/model-card.tsx b/web/src/features/pricing/components/model-card.tsx
index 45461ed..ae97f0d 100644
--- a/web/src/features/pricing/components/model-card.tsx
+++ b/web/src/features/pricing/components/model-card.tsx
@@ -293,8 +293,10 @@ export const ModelCard = memo(function ModelCard(props: ModelCardProps) {
   return (
     <div
       className={cn(
-        'group relative flex flex-col rounded-xl border p-3 transition-colors sm:p-5',
-        'hover:bg-muted/20'
+        'group relative flex flex-col overflow-hidden rounded-xl border p-3 transition-colors sm:p-5',
+        'hover:bg-muted/20 hover:border-foreground/20',
+        // Brand accent: a lime top edge sweeps in on hover / keyboard focus.
+        'before:pointer-events-none before:absolute before:inset-x-0 before:top-0 before:h-0.5 before:origin-left before:scale-x-0 before:bg-[var(--brand-lime,var(--primary))] before:transition-transform before:duration-500 before:ease-[cubic-bezier(0.77,0,0.18,1)] focus-within:before:scale-x-100 hover:before:scale-x-100 motion-reduce:before:transition-none'
       )}
     >
       {/* Header: icon + name + price + actions */}
