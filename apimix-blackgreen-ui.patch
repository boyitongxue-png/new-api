+        </div>
+      </div>
+
+      <div className='amx-wrap amx-hero-foot'>
+        <ul className='amx-checks' aria-label={t('home.landing.checksLabel')}>
+          {checks.map((label) => (
+            <li key={label}>
+              <LandingCheckIcon />
+              {label}
+            </li>
+          ))}
+        </ul>
+        {props.host ? <span className='amx-mono'>{props.host}</span> : null}
+      </div>
+    </section>
+  )
+}
